{
    "name": "kariricode/http",
    "description": "PSR-7, PSR-15 and PSR-17 for PHP 8.4: validated messages, a middleware dispatcher, CORS and client-certificate middleware, and a request handler backed by kariricode/router.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "kariricode",
        "http",
        "psr-7",
        "psr-15",
        "psr-17",
        "middleware",
        "cors",
        "mtls",
        "router"
    ],
    "homepage": "https://github.com/KaririCode-PHP/http",
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org",
            "homepage": "https://kariricode.org",
            "role": "Lead Architect"
        }
    ],
    "support": {
        "issues": "https://github.com/KaririCode-PHP/http/issues",
        "source": "https://github.com/KaririCode-PHP/http",
        "security": "https://github.com/KaririCode-PHP/http/security/policy"
    },
    "require": {
        "php": "^8.4",
        "kariricode/exception": "^2.0.2",
        "kariricode/router": "^4.1",
        "psr/clock": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "provide": {
        "psr/http-factory-implementation": "1.0",
        "psr/http-message-implementation": "2.0",
        "psr/http-server-handler-implementation": "1.0",
        "psr/http-server-middleware-implementation": "1.0"
    },
    "suggest": {
        "ext-openssl": "ClientCertificate::fromOpenSslCertificate() and fingerprints computed from a forwarded PEM certificate"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Http\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/sapi-functions.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "spec": "4.3.3",
            "error-code-range": "HTTP 1700–1799"
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "scripts": {
        "test": "kcode test",
        "test-unit": "kcode test --testsuite=unit",
        "test-conformance": "kcode test --testsuite=conformance",
        "phpstan": "kcode run phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "kcode run psalm --no-cache",
        "complexity": "@php tools/complexity.php src",
        "mutation": "kcode run infection --threads=max --no-progress --show-mutations",
        "security": [
            "@composer audit --locked",
            "@composer audit --locked --working-dir=.kcode",
            "@php tools/secret-scan.php"
        ],
        "sbom": "@php tools/sbom.php sbom.cdx.json",
        "cs-check": "kcode cs:fix --check",
        "cs-fix": "kcode cs:fix",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@mutation"
        ]
    },
    "scripts-descriptions": {
        "test": "All suites (unit, conformance)",
        "phpstan": "PHPStan at level max",
        "psalm": "Psalm at errorLevel 1",
        "complexity": "Spec V4.3.3 §13 budgets: cyclomatic, nesting, parameters",
        "mutation": "Infection, MSI and covered MSI >= 80",
        "security": "composer audit of the runtime and the toolchain, and a secret scan",
        "sbom": "CycloneDX 1.5 SBOM from composer.lock",
        "check": "Every gate CI runs, in order"
    }
}
