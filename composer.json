{
    "name": "kariricode/http",
    "description": "PSR-7/15/17 HTTP implementation for the KaririCode Framework \u2014 ARFA 1.3 compliant",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "http",
        "psr-7",
        "psr-15",
        "psr-17",
        "request",
        "response",
        "middleware",
        "kariricode"
    ],
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org"
        }
    ],
    "require": {
        "php": ">=8.4",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.1",
        "kariricode/router": "^4.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Http\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "4.0.x-dev"
        },
        "arfa": {
            "level": 1,
            "version": "1.3"
        }
    }
}